{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://studenthub-backend.onrender.com/api/:path*"
    },
    {
      "source": "/h2-console/:path*",
      "destination": "https://studenthub-backend.onrender.com/h2-console/:path*"
    },
    {
      "source": "/h2-console",
      "destination": "https://studenthub-backend.onrender.com/h2-console"
    },
    {
      "source": "/((?!api/|h2-console).*)",
      "destination": "/index.html"
    }
  ]
}
